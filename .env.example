# Copy to .env and add your own key. Do not commit .env.
OPENWEATHER_API_KEY=replace_with_your_key
CTA_API_KEY=replace_with_your_cta_bus_tracker_key
# Calendar: choose a private Google Calendar Secret address in iCal format,
# OR a local file in calendar_data/ (e.g. sample.ics). Do not commit secrets.
# CALENDAR_ICS_URL=https://calendar.google.com/calendar/ical/your-secret/basic.ics
# CALENDAR_ICS_FILE=sample.ics
CALENDAR_SHOW_DETAILS=true
